    <style>
        :root {
            --bg-base: #0b0c10;
            --card-base: #14161d;
            --accent-veg: #00ffcc;
            --accent-nonveg: #ff5500;
            --accent-active: #ff3366;
            --glass-border: rgba(255, 255, 255, 0.06);
            --text-main: #f5f5f7;
            --text-muted: #86868b;
            --mesh-glow: rgba(255, 51, 102, 0.05);
        }
        body.theme-veg {
            --bg-base: #020b06;
            --card-base: #08130d;
            --accent-active: var(--accent-veg);
            --mesh-glow: rgba(0, 255, 204, 0.06);
        }
        body.theme-nonveg {
            --bg-base: #0c0502;
            --card-base: #140b08;
            --accent-active: var(--accent-nonveg);
            --mesh-glow: rgba(255, 85, 0, 0.06);
        }
        body.theme-veg .item-nonveg, body.theme-nonveg .item-veg { display: none !important; }
        * { margin: 0; padding: 0; box-sizing: border-box; font-family: 'Plus Jakarta Sans', sans-serif; }
        body {
            background-color: var(--bg-base);
            color: var(--text-main);
            overflow-x: hidden;
            min-height: 100vh;
            transition: background-color 0.8s ease;
        }
        /* --- VECTOR OVERLAY NETWORKING --- */
        .vector-bg-layer {
            position: fixed;
            top: 0; left: 0; width: 100%; height: 100%;
            z-index: -1;
            pointer-events: none;
            overflow: hidden;
        }
        .mesh-glow {
            position: absolute; width: 100%; height: 100%;
            background: radial-gradient(circle at 50% -20%, var(--mesh-glow) 0%, transparent 60%);
            transition: all 0.8s ease;
        }
        .floating-vector {
            position: absolute;
            fill: var(--accent-active);
            opacity: 0.06;
            animation: drift 25s infinite linear;
            transition: fill 0.8s ease;
        }
        @keyframes drift {
            0% { transform: translateY(110vh) rotate(0deg); opacity: 0; }
            15% { opacity: 0.06; }
            85% { opacity: 0.06; }
            100% { transform: translateY(-20vh) rotate(360deg); opacity: 0; }
        }
        /* --- IMMERSIVE INTERACTIVE SLIDER GATEWAY --- */
        #gateway {
            position: fixed;
            top: 0; left: 0; width: 100vw; height: 100vh;
            background: #060709;
            z-index: 10000;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            transition: transform 0.7s cubic-bezier(0.85, 0, 0.15, 1), background 0.3s ease;
        }
        #gateway.passed { transform: translateY(-100%); }
        .gateway-title {
            font-size: clamp(3rem, 10vw, 5rem);
            font-weight: 800;
            letter-spacing: -3px;
            margin-bottom: 8px;
            background: linear-gradient(180deg, #fff 40%, #555);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }
        
        .gateway-subtitle {
            color: var(--text-muted);
            margin-bottom: 50px;
            font-size: 0.95rem;
            letter-spacing: 0.3px;
        }
        .slider-panel-container {
            width: 90%;
            max-width: 480px;
            background: rgba(255, 255, 255, 0.02);
            border: 1px solid var(--glass-border);
            padding: 50px 35px;
            border-radius: 32px;
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            box-shadow: 0 30px 60px rgba(0,0,0,0.6);
            display: flex;
            flex-direction: column;
            gap: 25px;
        }
        .slider-labels-row {
            width: 100%;
            display: flex;
            justify-content: space-between;
            font-weight: 800;
            font-size: 1.2rem;
            letter-spacing: 1px;
        }
        .label-veg { color: var(--accent-veg); opacity: 0.4; transition: transform 0.4s cubic-bezier(0.25, 1.5, 0.5, 1), opacity 0.3s ease; }
        .label-nonveg { color: var(--accent-nonveg); opacity: 0.4; transition: transform 0.4s cubic-bezier(0.25, 1.5, 0.5, 1), opacity 0.3s ease; }
        .slider-track-wrap { position: relative; width: 100%; display: flex; align-items: center; }
        .vibe-range-input {
            -webkit-appearance: none;
            width: 100%;
            height: 12px;
            border-radius: 10px;
            background: #16181f;
            outline: none;
            cursor: pointer;
            box-shadow: inset 0 2px 5px rgba(0,0,0,0.7);
        }
        .vibe-range-input::-webkit-slider-thumb {
            -webkit-appearance: none;
            appearance: none;
            width: 40px;
            height: 40px;
            border-radius: 50%;
            background: #ffffff;
            box-shadow: 0 10px 25px rgba(0, 0, 0, 0.8), 0 0 0 6px rgba(255,255,255,0.05);
            cursor: grab;
            transition: transform 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275), background-color 0.3s;
        }
        .vibe-range-input::-webkit-slider-thumb:active { cursor: grabbing; transform: scale(1.18); }
        /* --- CORE VISUAL STOREFRONT HERO --- */
        .showcase-hero {
            width: 100%;
            max-width: 1100px;
            margin: 0 auto;
            padding: 80px 20px 30px;
            text-align: center;
        }
        .hero-badge {
            display: inline-block;
            padding: 6px 16px;
            border-radius: 50px;
            background: rgba(255,255,255,0.02);
            border: 1px solid var(--glass-border);
            color: var(--accent-active);
            font-size: 0.75rem;
            font-weight: 800;
            letter-spacing: 2px;
            margin-bottom: 20px;
            text-transform: uppercase;
            transition: color 0.5s ease;
        }
        .showcase-hero h1 {
            font-size: clamp(2rem, 6vw, 3.5rem);
            font-weight: 800;
            letter-spacing: -1.5px;
            line-height: 1.1;
            margin-bottom: 15px;
            background: linear-gradient(180deg, #ffffff 30%, var(--text-muted));
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }
        .showcase-hero p {
            font-size: clamp(0.9rem, 2vw, 1.05rem);
            color: var(--text-muted);
            max-width: 650px;
            margin: 0 auto;
            line-height: 1.6;
        }
        /* --- TABBED SCROLLER NAVIGATION --- */
        .tabs-sticky-wrapper {
            position: sticky;
            top: 0;
            background: var(--bg-base);
            z-index: 900;
            border-bottom: 1px solid var(--glass-border);
            padding: 12px 0;
            transition: background-color 0.5s;
        }
        .tabs-container { max-width: 1100px; margin: 0 auto; padding: 0 20px; overflow-x: auto; scrollbar-width: none; }
        .tabs-container::-webkit-scrollbar { display: none; }
        .tabs { display: flex; gap: 10px; }
        .tab-btn {
            background: rgba(255,255,255,0.02);
            border: 1px solid var(--glass-border);
            color: var(--text-muted);
            padding: 14px 24px;
            border-radius: 14px;
            font-size: 0.9rem;
            font-weight: 700;
            cursor: pointer;
            white-space: nowrap;
            transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
        }
        .tab-btn:hover { color: var(--text-main); border-color: rgba(255,255,255,0.15); }
        .tab-btn.active { background: var(--text-main); color: #000; border-color: transparent; }
        /* --- PRODUCT GRID ARRANGEMENT --- */
        .menu-wrapper { max-width: 1100px; margin: 40px auto 120px; padding: 0 20px; }
        
        .menu-grid {
            display: none;
            grid-template-columns: repeat(auto-fill, minmax(310px, 1fr));
            gap: 25px;
        }
        .menu-grid.active-grid { display: grid; animation: feedReveal 0.6s cubic-bezier(0.16, 1, 0.3, 1) forwards; }
        @keyframes feedReveal { from { opacity: 0; transform: translateY(20px); } to { opacity: 1; transform: translateY(0); } }
        .food-card {
            background: var(--card-base);
            border: 1px solid var(--glass-border);
            border-radius: 24px;
            padding: 25px;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            transition: border-color 0.3s, background-color 0.5s;
        }
        .food-card:hover { border-color: var(--accent-active); }
        .card-title-line { display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 6px; }
        .food-card h3 { font-size: 1.2rem; font-weight: 700; letter-spacing: -0.3px; }
        
        .indicator-dot { width: 14px; height: 14px; border: 1px solid transparent; display: flex; align-items: center; justify-content: center; flex-shrink: 0; margin-top: 3px; }
        .indicator-dot.veg { border-color: var(--accent-veg); }
        .indicator-dot.veg::after { content: ''; width: 6px; height: 6px; background: var(--accent-veg); border-radius: 50%; }
        .indicator-dot.nonveg { border-color: var(--accent-nonveg); }
        .indicator-dot.nonveg::after { content: ''; width: 6px; height: 6px; background: var(--accent-nonveg); border-radius: 50%; }
        .food-card p { color: var(--text-muted); font-size: 0.85rem; line-height: 1.4; margin-bottom: 20px; }
        .card-footer {
            display: flex;
            justify-content: space-between;
            align-items: center;
            border-top: 1px solid rgba(255,255,255,0.04);
            padding-top: 16px;
        }
        .price-text { font-weight: 800; color: var(--text-main); font-size: 1.15rem; }
        .multi-prices { display: flex; gap: 6px; }
        .size-pill {
            background: rgba(255,255,255,0.03); border: 1px solid var(--glass-border);
            padding: 4px 8px; border-radius: 8px; font-size: 0.75rem; font-weight: 600;
        }
        .size-pill span { color: var(--text-muted); font-size: 0.65rem; margin-right: 3px; }
        .action-tray { display: flex; gap: 8px; margin-top: 15px; }
        .action-button {
            flex: 1; padding: 11px; border-radius: 12px; font-size: 0.8rem;
            font-weight: 700; text-align: center; text-decoration: none; cursor: pointer;
            transition: 0.2s; border: 1px solid transparent;
        }
        .btn-call { background: transparent; border-color: var(--glass-border); color: var(--text-main); }
        .btn-call:hover { background: rgba(255,255,255,0.04); }
        .btn-order { background: var(--accent-active); color: #000; font-weight: 800; transition: background 0.5s, color 0.5s; }
        .btn-order:hover { opacity: 0.9; }
        /* --- STICKY CONSOLE RESET CONSOLE --- */
        .vibe-reset-pill {
            position: fixed; bottom: 30px; right: 30px; z-index: 999;
            background: #ffffff; color: #000000; padding: 12px 24px;
            border-radius: 50px; cursor: pointer; font-weight: 800; font-size: 0.85rem;
            box-shadow: 0 10px 30px rgba(0,0,0,0.5); border: none;
            transition: transform 0.2s cubic-bezier(0.175, 0.885, 0.32, 1.275);
        }
        .vibe-reset-pill:hover { transform: scale(1.05); }
        @media (max-width: 600px) {
            .slider-panel-container { padding: 40px 20px; }
            .vibe-reset-pill { bottom: 20px; right: 20px; padding: 10px 18px; font-size: 0.75rem; }
        }
    </style>
</head>
