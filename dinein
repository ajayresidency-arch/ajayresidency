    <script>
        const vegPaths = [
            "M12,2L9,5H15L12,2M12,6C15.31,6 18,8.69 18,12C18,15.31 15.31,18 12,18C8.69,18 6,15.31 6,12C6,8.69 8.69,6 12,6Z", 
            "M17,13H7V11H17M12,2A10,10 0 0,0 2,12A10,10 0 0,0 12,22A10,10 0 0,0 22,12A10,10 0 0,0 12,2Z"
        ];
        const nonVegPaths = [
            "M11,9H13V11H11V9M11,13H13V17H11V13M12,2A10,10 0 0,0 2,12A10,10 0 0,0 12,22A10,10 0 0,0 22,12A10,10 0 0,0 12,2Z", 
            "M18.6,6.62C17.55,5.57 16.15,5 14.66,5C13.17,5 11.77,5.57 10.72,6.62L5.1,12.24L12.17,19.31"
        ];
        // Fluid Input Linear Interpolation Physics
        function handleSliderMovement(val) {
            const gateway = document.getElementById('gateway');
            const labelVeg = document.getElementById('text-veg');
            const labelNonVeg = document.getElementById('text-nonveg');
            
            if (val < 50) {
                let intensity = (50 - val) / 50; 
                gateway.style.background = `radial-gradient(circle at 30% 50%, rgba(0, 255, 204, ${intensity * 0.4}) 0%, #060709 70%)`;
                labelVeg.style.opacity = 0.4 + (intensity * 0.6);
                labelVeg.style.transform = `scale(${1 + intensity * 0.15})`;
                labelNonVeg.style.opacity = 0.4 - (intensity * 0.3);
                labelNonVeg.style.transform = "scale(1)";
                
                if (parseInt(val) === 0) {
                    commitProfileMode('veg');
                }
            } else if (val > 50) {
                let intensity = (val - 50) / 50;
                gateway.style.background = `radial-gradient(circle at 70% 50%, rgba(255, 85, 0, ${intensity * 0.4}) 0%, #060709 70%)`;
                labelNonVeg.style.opacity = 0.4 + (intensity * 0.6);
                labelNonVeg.style.transform = `scale(${1 + intensity * 0.15})`;
                labelVeg.style.opacity = 0.4 - (intensity * 0.3);
                labelVeg.style.transform = "scale(1)";
                
                if (parseInt(val) === 100) {
                    commitProfileMode('nonveg');
                }
            } else {
                gateway.style.background = "#060709";
                labelVeg.style.opacity = "0.4";
                labelNonVeg.style.opacity = "0.4";
                labelVeg.style.transform = "scale(1)";
                labelNonVeg.style.transform = "scale(1)";
            }
        }
        function commitProfileMode(choice) {
            const body = document.body;
            const gateway = document.getElementById('gateway');
            const titleEl = document.getElementById('dynamic-title');
            
            body.classList.remove('theme-veg', 'theme-nonveg');
            body.classList.add('theme-' + choice);
            
            titleEl.innerText = choice === 'veg' ? "The Fresh Plant Universe" : "The Fire & Tandoor Domain";
            
            document.querySelectorAll('.tab-btn').forEach(btn => {
                if(choice === 'veg' && btn.classList.contains('nav-nonveg')) btn.style.display = 'none';
                else if(choice === 'nonveg' && btn.classList.contains('nav-veg')) btn.style.display = 'none';
                else btn.style.display = 'block';
            });
            spawnVectors(choice);
            gateway.classList.add('passed');
        }
        function resetVibe() {
            const slider = document.getElementById('vibeSlider');
            slider.value = 50; 
            handleSliderMovement(50);
            document.getElementById('gateway').classList.remove('passed');
        }
        function spawnVectors(type) {
            const container = document.getElementById('bg-canvas');
            document.querySelectorAll('.floating-vector').forEach(v => v.remove());
            const activeIcons = type === 'nonveg' ? nonVegPaths : vegPaths;
            
            for(let i = 0; i < 18; i++) {
                const svg = document.createElementNS("http://www.w3.org/2000/svg", "svg");
                const path = document.createElementNS("http://www.w3.org/2000/svg", "path");
                
                svg.setAttribute("viewBox", "0 0 24 24");
                svg.classList.add("floating-vector");
                
                svg.style.left = Math.random() * 100 + "vw";
                svg.style.width = (Math.random() * 35 + 20) + "px";
                svg.style.animationDuration = (Math.random() * 12 + 14) + "s";
                svg.style.animationDelay = (Math.random() * -20) + "s";
                
                path.setAttribute("d", activeIcons[Math.floor(Math.random() * activeIcons.length)]);
                svg.appendChild(path);
                container.appendChild(svg);
            }
        }
        function switchTab(event, gridId) {
            document.querySelectorAll('.tab-btn').forEach(btn => btn.classList.remove('active'));
            document.querySelectorAll('.menu-grid').forEach(grid => grid.classList.remove('active-grid'));
            event.target.classList.add('active');
            document.getElementById(gridId).classList.add('active-grid');
        }
        window.onload = () => spawnVectors('veg');
    </script>
